<?xml version="1.0" encoding="UTF-8"?>
<!-- GtkSourceView 5 (GNOME Text Editor) copy of neon.xml: that library wants
     version="1.0" and rejects "kind", the reverse of gedit's.
     Mirrors the "Neon" GNOME Terminal profile and dotfiles/neon-purple-theme.el -->
<style-scheme id="neon" name="Neon" version="1.0">
  <description>Neon purple, matching the terminal and Emacs themes</description>

  <color name="bg"        value="#3A1160"/>
  <color name="bg-dim"    value="#2A0C48"/>
  <color name="bg-alt"    value="#4E1980"/>
  <color name="bg-region" value="#5A2A8C"/>
  <color name="fg"        value="#FFFFFF"/>
  <color name="fg-var"    value="#E6D6FF"/>
  <color name="fg-dim"    value="#BDA99B"/>
  <color name="fg-dimmer" value="#8B7E96"/>
  <color name="pink"      value="#FE53BB"/>
  <color name="green"     value="#23EE15"/>
  <color name="yellow"    value="#FFE700"/>
  <color name="blue"      value="#C46BFF"/>
  <color name="magenta"   value="#FF6BFF"/>
  <color name="cyan"      value="#00FFCA"/>

  <style name="text"                    foreground="fg" background="bg"/>
  <style name="selection"               foreground="fg" background="bg-region"/>
  <style name="cursor"                  foreground="cyan"/>
  <style name="secondary-cursor"        foreground="fg-dimmer"/>
  <style name="current-line"            background="bg-dim"/>
  <style name="current-line-number"     foreground="yellow" background="bg" bold="true"/>
  <style name="line-numbers"            foreground="fg-dimmer" background="bg"/>
  <style name="draw-spaces"             foreground="fg-dimmer"/>
  <style name="bracket-match"           foreground="bg" background="cyan" bold="true"/>
  <style name="bracket-mismatch"        foreground="bg" background="pink" bold="true"/>
  <style name="right-margin"            foreground="fg" background="bg-alt"/>
  <style name="search-match"            foreground="bg" background="cyan"/>

  <style name="def:comment"             foreground="fg-dim" italic="true"/>
  <style name="def:shebang"             foreground="fg-dim" bold="true"/>
  <style name="def:doc-comment-element" foreground="cyan" italic="true"/>
  <style name="def:string"              foreground="green"/>
  <style name="def:constant"            foreground="magenta"/>
  <style name="def:special-char"        foreground="magenta"/>
  <style name="def:identifier"          foreground="fg-var"/>
  <style name="def:function"            foreground="cyan"/>
  <style name="def:statement"           foreground="pink"/>
  <style name="def:type"                foreground="yellow"/>
  <style name="def:operator"            foreground="fg"/>
  <style name="def:preprocessor"        foreground="blue"/>
  <style name="def:error"               foreground="pink" bold="true"/>
  <style name="def:warning"             foreground="yellow" bold="true"/>
  <style name="def:note"                foreground="cyan" bold="true"/>
  <style name="def:underlined"          italic="true" underline="single"/>

  <style name="diff:added-line"         foreground="green"/>
  <style name="diff:removed-line"       foreground="pink"/>
  <style name="diff:changed-line"       foreground="yellow"/>
  <style name="diff:location"           foreground="cyan"/>
</style-scheme>
